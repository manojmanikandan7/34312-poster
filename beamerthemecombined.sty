\ProvidesPackage{beamerthemecombined}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Base structure from zurichposter, styling from smls09
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{tikz}
\usetikzlibrary{arrows,decorations.pathmorphing,backgrounds,calc}
\RequirePackage{amsmath,amssymb,bm,amsthm}
\usefonttheme{default}

\selectcolormodel{cmyk}
\mode<presentation>

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Color scheme from smls09
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\definecolor{gppmcolorscheme1}{HTML}{BFCDE6}  % e.g. for block title
\definecolor{gppmcolorscheme5}{HTML}{E0E0E0}  % e.g. for block background
\definecolor{gppmcolorscheme2}{HTML}{000000}  % e.g. title in headline
\definecolor{gppmcolorscheme3}{HTML}{0033cc}  % e.g. for poster background
\definecolor{gppmcolorscheme4}{HTML}{000000}
\definecolor{gppmcolorscheme6}{cmyk}{0.72,1,0,0}
\definecolor{gppmcolorschemeHeadline}{HTML}{000000}  % for headline bg
\definecolor{gppmcolorschemeFootline}{HTML}{000000}  % for headline bg
\definecolor{darkgray}{HTML}{404040}  % dark gray for headings

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Color assignments using smls09 colors
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% headline colors and fonts
\setbeamercolor{headline}{bg=white,fg=darkgray}
\setbeamercolor{title in headline}{fg=darkgray}
\setbeamercolor{author in headline}{fg=darkgray}
\setbeamercolor{institute in headline}{fg=darkgray}
\setbeamercolor{logo in headline}{fg=black,bg=lightgray}
\setbeamercolor{separation line}{bg=lightgray}

% footline colors and fonts
\setbeamercolor{footline}{bg=white,fg=black}
\setbeamerfont{footline}{size=\Large}

% body colors and fonts
\setbeamercolor*{normal text}{fg=black,bg=gppmcolorscheme5}

% block environment (normal blocks)
\setbeamercolor*{block body}{bg=white,fg=black}
\setbeamerfont*{block body}{size=\normalsize}
\setbeamercolor*{block title}{fg=white,bg=gppmcolorscheme6}
\setbeamerfont{block title}{size=\large,series=\bfseries}

% example environment
\setbeamercolor{block title example}{fg=darkgray,bg=gppmcolorscheme1}
\setbeamercolor{block body example}{bg=white,fg=black}
\setbeamerfont{block title example}{size=\large,series=\bfseries}

% alerted environment
\setbeamercolor{block title alerted}{fg=white,bg=gppmcolorscheme3}
\setbeamercolor{block body alerted}{bg=white,fg=black}
\setbeamercolor{alerted text}{fg=darkgray}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Templates
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setbeamertemplate{itemize items}[triangle]
\setbeamertemplate{navigation symbols}{}  % no navigation on a poster

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Block templates from zurichposter with smls09 styling
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setbeamertemplate{block begin}{
  \vskip.75ex
  \begin{beamercolorbox}[rounded=true,leftskip=.4cm,colsep*=.75ex]{block title}%
    \usebeamerfont*{block title}\insertblocktitle
  \end{beamercolorbox}%
  {\ifbeamercolorempty[bg]{block body}{}{\nointerlineskip\vskip-0.5pt}}%
  \usebeamerfont{block body}%
  \begin{beamercolorbox}[rounded=true,colsep*=.75ex,sep=.5ex,vmode]{block body}%
    \ifbeamercolorempty[bg]{block body}{\vskip-.25ex}{\vskip-.75ex}\vbox{}%
  }

\setbeamertemplate{block end}{
  \end{beamercolorbox}
}

\setbeamertemplate{block alerted begin}{
  \vskip.75ex
  \begin{beamercolorbox}[rounded=true,leftskip=.4cm,colsep*=.75ex]{block title alerted}%
    \usebeamerfont*{block title alerted}\insertblocktitle
  \end{beamercolorbox}%
  {\ifbeamercolorempty[bg]{block alerted body}{}{\nointerlineskip\vskip-0.5pt}}%
  \usebeamerfont{block body alerted}%
  \begin{beamercolorbox}[rounded=true,colsep*=.75ex,sep=.5ex,vmode]{block body alerted}%
    \ifbeamercolorempty[bg]{block body alerted}{\vskip-.25ex}{\vskip-.75ex}\vbox{}%
  }

\setbeamertemplate{block alerted end}{
  \end{beamercolorbox}
}

\setbeamertemplate{block example begin}{
  \vskip.75ex
  \begin{beamercolorbox}[rounded=true,leftskip=.4cm,colsep*=.75ex]{block title example}%
    \usebeamerfont*{block title example}\insertblocktitle
  \end{beamercolorbox}%
  {\ifbeamercolorempty[bg]{block example body}{}{\nointerlineskip\vskip-0.5pt}}%
  \usebeamerfont{block body example}%
  \begin{beamercolorbox}[rounded=true,colsep*=.75ex,sep=.5ex,vmode]{block body example}%
    \ifbeamercolorempty[bg]{block body example}{\vskip-.25ex}{\vskip-.75ex}\vbox{}%
  }

\setbeamertemplate{block example end}{
  \end{beamercolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Headline template from smls09
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setbeamertemplate{headline}{
  \leavevmode

  \begin{beamercolorbox}[wd=\paperwidth]{headline}
    \vskip2ex
    \begin{columns}[T]
      \begin{column}{.005\paperwidth}
      \end{column}
      \begin{column}{.07\paperwidth}
        \vspace{-3.1mm}
        \begin{center}
          \includegraphics[height=5cm]{Manchester_Logo}
        \end{center}
      \end{column}  
      \begin{column}{.885\paperwidth}
        \vskip4ex
        \begin{center}
          \usebeamercolor{title in headline}{\color{fg}\textbf{\Huge{\inserttitle}}\\[1ex]}
          \usebeamercolor{author in headline}{\color{fg}\large{\insertauthor}\\[0.3ex]}
          \usebeamercolor{institute in headline}{\color{fg}\large{\insertinstitute}\\[1ex]}
        \end{center}
      \end{column}
    \end{columns}
    \vskip2ex
  \end{beamercolorbox}

  \begin{beamercolorbox}[wd=\paperwidth]{lower separation line head}
    \rule{0pt}{2pt}
  \end{beamercolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Footline template from smls09
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setbeamertemplate{footline}{
  \begin{beamercolorbox}[wd=\paperwidth]{lower separation line foot}
    \rule{0pt}{2pt}
  \end{beamercolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<all>

